  "content": "<style>\r\n\r\n.header{\r\n    width:100%;\r\n    font-family:Arial;\r\n    border:1px solid #d9e1ea;\r\n    border-bottom:none;\r\n    padding:8px 10px;\r\n    box-sizing:border-box;\r\n}\r\n\r\n.header-row{\r\n    display:flex;\r\n    align-items:center;\r\n}\r\n\r\n.left{\r\n    width:20%;\r\n}\r\n\r\n.center{\r\n    width:60%;\r\n    text-align:center;\r\n}\r\n\r\n.right{\r\n    width:20%;\r\n    text-align:right;\r\n}\r\n\r\n.hospital-name{\r\n    font-size:28px;\r\n    font-weight:bold;\r\n    color:#1565c0;\r\n}\r\n\r\n.address{\r\n    font-size:14px;\r\n    color:#444;\r\n}\r\n\r\n/* ================= CONTACT ================= */\r\n\r\n.contact-section{\r\n    border-top:1px solid #ececec;\r\n    margin-top:6px;\r\n    padding-top:6px;\r\n}\r\n\r\n.contact-table{\r\n    width:100%;\r\n    border-collapse:collapse;\r\n    table-layout:fixed;\r\n}\r\n\r\n.contact-table td{\r\n    width:25%;\r\n    font-size:10px;\r\n    color:#222;\r\n    vertical-align:middle;\r\n    white-space:nowrap;\r\n}\r\n\r\n.contact-table td:nth-child(1){\r\n    text-align:left;\r\n}\r\n\r\n.contact-table td:nth-child(2),\r\n.contact-table td:nth-child(3){\r\n    text-align:center;\r\n}\r\n\r\n.contact-table td:nth-child(4){\r\n    text-align:right;\r\n}\r\n\r\n.contact-icon{\r\n    color:#b00000;\r\n    font-size:11px;\r\n    font-weight:bold;\r\n    margin-right:3px;\r\n}\r\n\r\n/* ================= PATIENT DETAILS ================= */\r\n\r\n.patient-details{\r\n    width:100%;\r\n    border-collapse:collapse;\r\n    margin-top:0;\r\n    border:1px solid #d9e1ea;\r\n}\r\n\r\n.patient-details td{\r\n    width:50%;\r\n    vertical-align:top;\r\n    padding:6px 10px;\r\n}\r\n\r\n.patient-details td:first-child{\r\n    border-right:1px solid #d9e1ea;\r\n}\r\n\r\n.detail-row{\r\n    margin-bottom:4px;\r\n    line-height:1.5;\r\n}\r\n\r\n.detail-label{\r\n    display:inline-block;\r\n    width:110px;\r\n    font-weight:bold;\r\n}\r\n\r\n.detail-value{\r\n    display:inline-block;\r\n}\r\n\r\n</style>\r\n\r\n<div class=\"header\">\r\n\r\n    <div class=\"header-row\">\r\n\r\n        <div class=\"left\">\r\n            <img src=\"/files/favicon.png\" style=\"height:55px;\">\r\n        </div>\r\n\r\n        <div class=\"center\">\r\n\r\n            <div style=\"font-size:18px;color:#d4af37;font-weight:bold;\">\r\n                ಸೋಮೇಶ್ವರ ಆಸ್ಪತ್ರೆ\r\n            </div>\r\n\r\n            <div class=\"hospital-name\">\r\n                SOMESHWARA HOSPITAL\r\n            </div>\r\n\r\n            <div class=\"address\">\r\n                Madhavanagar, B.H. Road, Gauribidanur - 561208\r\n            </div>\r\n\r\n        </div>\r\n\r\n        <div class=\"right\">\r\n            <img src=\"/files/NABH-Accredited-SMH.png\" style=\"height:55px;\">\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <!-- Contact Section -->\r\n\r\n    <div class=\"contact-section\">\r\n\r\n        <table class=\"contact-table\">\r\n\r\n            <tr>\r\n\r\n                <td>\r\n                    <span class=\"contact-icon\">📞</span>\r\n                    +91 9945141393\r\n                </td>\r\n\r\n                <td>\r\n                    <span class=\"contact-icon\">📞</span>\r\n                    +91 9403994236\r\n                </td>\r\n\r\n                <td>\r\n                    <span class=\"contact-icon\">✉</span>\r\n                    someshwarahospital28@gmail.com\r\n                </td>\r\n\r\n                <td>\r\n                    <span class=\"contact-icon\">🌐</span>\r\n                    www.someshwarahospitals.com\r\n                </td>\r\n\r\n            </tr>\r\n\r\n        </table>\r\n\r\n    </div>\r\n\r\n</div>\r\n\r\n<!-- Patient Details -->\r\n\r\n<table class=\"patient-details\">\r\n\r\n    <tr>\r\n\r\n        <!-- LEFT COLUMN -->\r\n\r\n        <td>\r\n\r\n            <div class=\"detail-row\">\r\n                <span class=\"detail-label\">Patient Name</span> :\r\n                <span class=\"detail-value\">\r\n                    {{ doc.patient_name or doc.patient }}\r\n                </span>\r\n            </div>\r\n\r\n            <div class=\"detail-row\">\r\n                <span class=\"detail-label\">Age / Sex</span> :\r\n                <span class=\"detail-value\">\r\n                    {{ frappe.db.get_value(\"Patient\", doc.patient, \"custom_age\") or \"\" }}\r\n                    /\r\n                    {{ doc.patient_sex or \"\" }}\r\n                </span>\r\n            </div>\r\n\r\n            <div class=\"detail-row\">\r\n                <span class=\"detail-label\">Ref. Doctor</span> :\r\n                <span class=\"detail-value\">\r\n                    {{ doc.practitioner_name or \"-\" }}\r\n                </span>\r\n            </div>\r\n\r\n            <div class=\"detail-row\">\r\n                <span class=\"detail-label\">Lab No.</span> :\r\n                <span class=\"detail-value\">\r\n                    {{ doc.name }}\r\n                </span>\r\n            </div>\r\n\r\n        </td>\r\n\r\n        <!-- RIGHT COLUMN -->\r\n\r\n        <td>\r\n\r\n            <div class=\"detail-row\">\r\n                <span class=\"detail-label\">Registered On</span> :\r\n                <span class=\"detail-value\">\r\n                    {{ frappe.utils.format_datetime(doc.creation,\"dd/MM/yyyy HH:mm:ss\") }}\r\n                </span>\r\n            </div>\r\n\r\n            <div class=\"detail-row\">\r\n                <span class=\"detail-label\">Reported On</span> :\r\n                <span class=\"detail-value\">\r\n                    {{ frappe.utils.format_datetime(doc.modified,\"dd/MM/yyyy HH:mm:ss\") }}\r\n                </span>\r\n            </div>\r\n\r\n            <div class=\"detail-row\">\r\n                <span class=\"detail-label\">UID No.</span> :\r\n                <span class=\"detail-value\">\r\n                    {{ frappe.db.get_value(\"Patient\", doc.patient, \"uid\") or \"\" }}\r\n                </span>\r\n            </div>\r\n\r\n        </td>\r\n\r\n    </tr>\r\n\r\n</table>",
