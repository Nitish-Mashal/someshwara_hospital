  "footer": "<style>\r\n.footer-wrapper{\r\n    width:100%;\r\n    font-family:Arial,sans-serif;\r\n    font-size:11px;\r\n    border:1px solid #d9e1ea;\r\n    box-sizing:border-box;\r\n}\r\n\r\n.verification{\r\n    padding:12px;\r\n    border-bottom:1px solid #d9e1ea;\r\n}\r\n\r\n.verification-table{\r\n    width:100%;\r\n    border-collapse:collapse;\r\n}\r\n\r\n.verification-table td{\r\n    width:50%;\r\n    text-align:center;\r\n    vertical-align:top;\r\n    padding:8px;\r\n}\r\n\r\n.verification-table td:first-child{\r\n    border-right:1px solid #d9e1ea;\r\n}\r\n\r\n.verification-title{\r\n    font-size:13px;\r\n    font-weight:bold;\r\n    margin-bottom:12px;\r\n}\r\n\r\n.report-line{\r\n    margin-top:10px;\r\n}\r\n\r\n.line{\r\n    display:inline-block;\r\n    width:140px;\r\n    border-bottom:1px solid #444;\r\n    margin-left:8px;\r\n}\r\n\r\n.footer-services{\r\n    padding:8px;\r\n}\r\n\r\n.footer-services table{\r\n    width:100%;\r\n    border-collapse:collapse;\r\n}\r\n\r\n.footer-services td{\r\n    width:25%;\r\n    text-align:center;\r\n    color:#1565c0;\r\n    font-weight:bold;\r\n    font-size:11px;\r\n    padding:4px 0;\r\n}\r\n\r\n.thank-you{\r\n    background:#1565c0;\r\n    color:#fff;\r\n    text-align:center;\r\n    padding:6px;\r\n    font-style:italic;\r\n    margin:0;\r\n}\r\n</style>\r\n\r\n<div class=\"footer-wrapper\">\r\n\r\n    <div class=\"verification\">\r\n\r\n        <table class=\"verification-table\">\r\n\r\n            <tr>\r\n\r\n                <td>\r\n\r\n                    <div class=\"verification-title\">\r\n                        Verified By Lab Technologist\r\n                    </div>\r\n\r\n                    <div class=\"report-line\">\r\n                        Reported On\r\n                        <span class=\"line\"></span>\r\n                    </div>\r\n\r\n                </td>\r\n\r\n                <td>\r\n\r\n                    <div class=\"verification-title\">\r\n                        Verified By Pathologist\r\n                    </div>\r\n\r\n                    <div class=\"report-line\">\r\n                        Reported On\r\n                        <span class=\"line\"></span>\r\n                    </div>\r\n\r\n                </td>\r\n\r\n            </tr>\r\n\r\n        </table>\r\n\r\n    </div>\r\n\r\n    <div class=\"footer-services\">\r\n\r\n        <table>\r\n\r\n            <tr>\r\n\r\n                <td>24x7<br>EMERGENCY CARE</td>\r\n\r\n                <td>EXPERT DOCTORS<br>COMPASSIONATE CARE</td>\r\n\r\n                <td>ADVANCED DIAGNOSTICS<br>ACCURATE RESULTS</td>\r\n\r\n                <td>YOUR HEALTH<br>OUR PRIORITY</td>\r\n\r\n            </tr>\r\n\r\n        </table>\r\n\r\n    </div>\r\n\r\n    <div class=\"thank-you\">\r\n        Thank you for trusting Someshwara Hospital, Gauribidanur.\r\n    </div>\r\n\r\n</div>",
